// EQUB platform schema — see EQUB_GROUND_TRUTH.md before changing anything.
// Money is ALWAYS stored in cents as Int. Derived values (weeks credited,
// behind-count, late, balances) are never stored — see ground truth 2.14.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Person {
  id               String   @id @default(cuid())
  nameAmharic      String
  nameEnglishFirst String
  nameEnglishLast  String?
  phone            String?
  notes            String?
  // Supabase Auth identity (auth.users.id). Null until the person is
  // provisioned or first signs in — a directory entry alone cannot log in,
  // and that is expected (2.5: the organizer adds people before they sign in).
  authUserId       String?  @unique @db.Uuid
  // Transition-period PIN login (retired at cycle 2): bcrypt hash only —
  // never plaintext — with durable server-side lockout state.
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Per-person override of the pinLoginEnabled setting: null follows the
  // global toggle, true allows PIN even when globally off, false forces OTP
  // even when globally on. Enforced SERVER-side, never by UI hiding.
  pinLoginAllowed   Boolean?
  // Hardship flag (2.20): when true, NO message of any kind goes to this
  // person — automatic or manual. Enforced server-side at send time, never
  // by the UI merely unchecking them.
  noMessages       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  participations   Participation[]
  ledgerEntries    LedgerEntry[]
  messageLogs      MessageLog[]
  signInSessions   SignInSession[]
  agreementSignatures AgreementSignature[]
  @@map("people")
}

// EVERY SIGN-IN, AND WHAT IT IS STILL DOING.
//
// The organizer's ruling removed the second factor from the phone-digit
// default PIN — members sign in directly. The protection moved here: a row
// per sign-in, so a session can be bounded (lib/session-policy.ts), shown to
// the person it belongs to, and ended by them.
//
// AWARENESS, NEVER BLOCKING. Nothing in this table may refuse a login.
// Fingerprints change on browser updates and IPs change on networks; both are
// recorded so a member can recognise their own history, not so the system can
// judge it.
model SignInSession {
  id           String  @id @default(cuid())
  // The Supabase auth user behind the session. Set for members AND for the
  // organizer; personId is set only for members, so the organizer's own
  // sessions are still listable without a directory row.
  authUserId   String  @db.Uuid
  personId     String?
  role         String  // MEMBER | ADMIN — see SessionRole in lib/session-policy
  method       String  // PIN | WHATSAPP | SMS | PASSWORD
  // The cookie is the only copy of the token; this is its SHA-256. A database
  // reader must not come away able to impersonate a live session.
  tokenHash    String  @unique
  // Awareness, in the words the UI shows (lib/device.ts).
  fingerprint  String
  userAgent    String
  browser      String
  os           String
  deviceType   String
  ip           String
  location     String?
  // True when this device/IP combination had never been seen for this person.
  // Cleared by noticeSeenAt once they have actually read the notice, so it
  // shows once and prominently rather than nagging forever.
  isNewDevice  Boolean   @default(false)
  noticeSeenAt DateTime?
  createdAt    DateTime  @default(now())
  // The sliding idle clock reads this. Written at most once a heartbeat.
  lastSeenAt   DateTime  @default(now())
  // Set by "Sign out everywhere else" and by ordinary sign-out. A revoked row
  // is KEPT, not deleted — the history is the point (2.14).
  revokedAt    DateTime?
  revokedReason String?
  person       Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  // The proxy's hot path: one lookup by tokenHash on every request.
  @@index([authUserId, revokedAt])
  @@index([personId, createdAt])
  @@map("sign_in_sessions")
}

// Organizer-editable message wording (2.20/D-27): one row per message type,
// filled from DERIVED state at send time (2.21) — the body carries
// {placeholders}, never numbers. metaTemplateSid records the Meta-approved
// WhatsApp template name/SID (2.28) once Meta approval lands, so each type
// can be mapped to its approved template for sends outside the 24-hour window.
model MessageTemplate {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  body            String
  metaTemplateSid String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  logs            MessageLog[]
  @@map("message_templates")
}

// Every message that actually left (or failed leaving): who, which template,
// the EXACT rendered body, over which channel, and what the provider said.
// templateKey is copied at send time so the record survives template edits;
// the row is append-only — the log is the organizer's proof of what was said.
model MessageLog {
  id          String            @id @default(cuid())
  personId    String
  templateId  String?
  templateKey String
  body        String
  channel     String            @default("WHATSAPP")
  toPhone     String
  trigger     MessageTrigger
  status      MessageSendStatus
  providerSid String?
  error       String?
  createdAt   DateTime          @default(now())
  person      Person            @relation(fields: [personId], references: [id])
  template    MessageTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  @@index([personId])
  @@index([createdAt])
  @@map("message_logs")
}

model Cycle {
  id            String      @id @default(cuid())
  name          String
  startDate     DateTime
  plannedWeeks  Int
  unitAmount    Int         @default(100000)
  feePercent    Float       @default(2.0)
  status        CycleStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  closedAt      DateTime?
  weeks         Week[]
  participations Participation[]
  slots         Slot[]
  winnerPlans   WinnerPlan[]
  luckyNumbers  LuckyNumber[]
  // NOTE: the database also carries a partial unique index "one_active_cycle"
  // (see migration lucky_number_per_cycle_and_one_active_cycle) enforcing at
  // most ONE row with status = 'ACTIVE'. Prisma cannot express partial
  // indexes, so it lives in raw SQL — NEVER let a generated migration drop it.
  @@map("cycles")
}

model Week {
  id         String   @id @default(cuid())
  cycleId    String
  weekNumber Int
  date       DateTime
  isSkipped  Boolean  @default(false)
  notes      String?
  cycle      Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  payments   Payment[]
  draws      Draw[]
  winnerPlans WinnerPlan[]
  pinnedEvents PaymentEvent[]
  @@unique([cycleId, weekNumber])
  @@map("weeks")
}

model Participation {
  id             String   @id @default(cuid())
  cycleId        String
  personId       String
  weeklyAmount   Int
  startWeek      Int      @default(1)
  weeksCommitted Int
  status         ParticipationStatus @default(ACTIVE)
  // SENDING THE WELCOME IS WHAT REQUIRES A SIGNATURE (organizer ruling).
  //
  // Null means this member was never sent one, and is therefore not gated —
  // which is exactly how the 27 members already mid-cycle stay untouched
  // without a date comparison or an exemption list. Sending the welcome to
  // anyone, new or existing, is the deliberate act that brings them into
  // signing.
  //
  // A TIMESTAMP, NOT A FLAG, and that is what removes the whole re-sign
  // problem. The gate asks "is there a signature NEWER than this?", so
  // sending again — after changing someone from 10 weeks to 12 — sets a later
  // moment and gates them once more against the CURRENT terms. There is no
  // re-sign flow to build because a new send IS the new requirement.
  agreementRequiredAt DateTime?
  signatures     AgreementSignature[]
  // WHERE THEY STOPPED (2.18). Inclusive: closing at week 12 keeps weeks 1–12
  // expected and drops 13 onward. Their window ends here, and because every
  // derived figure in the platform already asks "is this week in their
  // window", that one fact takes them out of expected, behind, outstanding
  // and the lucky-number pool (2.27) at once.
  closedAtWeek   Int?
  /** Neutral, from a fixed list (lib/participation-close.ts). Never personal. */
  closeReason    String?
  /** Only for "Other" — about the arrangement, never about the person. */
  closeNote      String?
  closedAt       DateTime?
  // D-23 / 2.18: what the organizer decided about this person's CARRIED
  // BALANCE when adding them to this cycle — "leave", "deduct" or
  // "settle-now". An INTENTION and nothing more: it decides only whether the
  // deduction offer arrives pre-ticked at payout time. Applying it always
  // needs a fresh confirmation (lib/carry-balance.ts).
  //
  // It lives on the participation because the decision is per person PER
  // CYCLE — the same member can carry a balance into two cycles and be
  // treated differently in each.
  carryIntent       String?
  carryIntentAt     DateTime?
  /** The balance at the moment of the choice. The live balance may differ,
   *  and the LIVE one is what may be offered. Kept for the record only. */
  carryIntentAmount Int?
  createdAt      DateTime @default(now())
  cycle          Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  person         Person   @relation(fields: [personId], references: [id])
  luckyNumbers   LuckyNumber[]
  payments       Payment[]
  paymentEvents  PaymentEvent[]
  breaks         ParticipationBreak[]
  @@unique([cycleId, personId])
  @@map("participations")
}

/**
 * A stretch of weeks a member was NOT part of the cycle (2.18).
 *
 * WHY THIS IS A TABLE AND NOT TWO COLUMNS. `closedAtWeek` can only truncate a
 * window; it cannot describe a HOLE in one. The moment a stopped member is
 * brought back, the weeks they were away have to stay outside their
 * expectation for good — restoring them would invent arrears for weeks nobody
 * ever asked them about — and that is a hole, not a truncation. A member who
 * stops, resumes, and stops again has two of them.
 *
 * `toWeek` is null while they are still stopped: the break is open and their
 * window ends at `fromWeek - 1`. Closing the break is what "they are
 * contributing again" means, and it is why reactivation is forward-only by
 * construction rather than by a rule somebody has to remember.
 *
 * The reason lives here rather than on the participation because it belongs to
 * THIS break — a member who stopped twice stopped for two different reasons,
 * and the archive keeps both.
 */
model ParticipationBreak {
  id              String    @id @default(cuid())
  participationId String
  /** First week NOT counted. Their window ends at fromWeek − 1. */
  fromWeek        Int
  /** Last week not counted. Null while they are still stopped. */
  toWeek          Int?
  /** Neutral, from a fixed list (lib/participation-close.ts). */
  reason          String
  /** Only for "Other" — about the arrangement, never about the person. */
  note            String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  @@index([participationId])
  @@map("participation_breaks")
}

// cycleId is denormalized from participation.cycleId — it exists so the
// database itself can enforce that a lucky number is unique within a cycle.
// Every code path that creates lucky numbers must set it to the
// participation's cycle.
model LuckyNumber {
  id              String @id @default(cuid())
  participationId String
  cycleId         String
  number          Int
  amount          Int
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  cycle           Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  slotMembers     SlotMember[]
  payouts         Payout[]
  planNumbers     WinnerPlanNumber[]
  @@unique([cycleId, number])
  @@map("lucky_numbers")
}

model Payment {
  id              String   @id @default(cuid())
  weekId          String
  participationId String
  amountPaid      Int      @default(0)
  isDeferred      Boolean  @default(false)
  // THE ORGANIZER'S OWN LATE MARK (2.2 — his discretion; 2.14 — a STORED
  // decision, not a derived value).
  //
  // LATE is otherwise pure calendar: unpaid AND the window has closed. That
  // makes the organizer wait until Thursday to record something he was told on
  // Monday. This is the fact that he decided, and WHEN — a boolean would say
  // the decision exists without saying when it was made, and this is a
  // financial record.
  //
  // Money still wins: a week that gets paid reads PAID whatever this says, and
  // the payment path clears it. Cleared by unmarking too — it is reversible.
  markedLateAt    DateTime?
  markedLateNote  String?
  method          PaymentMethod?
  paidAt          DateTime?
  notes           String?
  week            Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  allocations     PaymentAllocation[]
  @@unique([weekId, participationId])
  @@map("payments")
}

// One RECEIPT of money from one person (2.14: the stored fact). A week is
// often paid across several receipts; the allocations join records which
// receipt filled which week. idempotencyKey is unique so a duplicate
// submission is rejected by the DATABASE, not by process memory.
model PaymentEvent {
  id              String   @id @default(cuid())
  participationId String
  amount          Int
  method          PaymentMethod?
  receivedAt      DateTime @default(now())
  notes           String?
  idempotencyKey  String   @unique
  createdAt      DateTime @default(now())
  // The winner's week is settled FROM the payout, not paid separately: a
  // pinned event allocates to THIS week only, never oldest-first. Set only
  // by the draw settlement; ordinary receipts leave it null.
  //
  // pinnedWeekId != null IS the definition of "this is a settlement receipt",
  // and settlementPayoutId records WHICH payout funded it. Both are written
  // only by lib/draw-settlement.ts and are unreachable from any client input
  // — identification must never be inferred from the idempotency key, which
  // the caller controls.
  pinnedWeekId    String?
  settlementPayoutId String?
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  pinnedWeek      Week?         @relation(fields: [pinnedWeekId], references: [id], onDelete: SetNull)
  settlementPayout Payout?      @relation(fields: [settlementPayoutId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  @@index([settlementPayoutId])
  @@map("payment_events")
}

// How much of one receipt landed on one week's payment row — the audit trail
// from event to weeks (2.18 spirit: the ledger keeps the story).
model PaymentAllocation {
  id        String @id @default(cuid())
  eventId   String
  paymentId String
  amount    Int
  event     PaymentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment   Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  @@unique([eventId, paymentId])
  @@map("payment_allocations")
}

model Slot {
  id       String @id @default(cuid())
  cycleId  String
  position Int
  cycle    Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  members  SlotMember[]
  draws    Draw[]
  @@unique([cycleId, position])
  @@map("slots")
}

model SlotMember {
  id            String @id @default(cuid())
  slotId        String
  luckyNumberId String
  slot          Slot        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  luckyNumber   LuckyNumber @relation(fields: [luckyNumberId], references: [id], onDelete: Cascade)
  @@unique([slotId, luckyNumberId])
  @@map("slot_members")
}

// The plan is intent, not state (ground truth 2.3): which numbers win, together
// or separate, in which week. Locked plans are excluded from reshuffle pools.
model WinnerPlan {
  id        String           @id @default(cuid())
  cycleId   String
  weekId    String?
  mode      WinnerPlanMode   @default(ALONE)
  status    WinnerPlanStatus @default(PLANNED)
  createdAt DateTime         @default(now())
  cycle     Cycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  week      Week?            @relation(fields: [weekId], references: [id], onDelete: SetNull)
  numbers   WinnerPlanNumber[]
  @@map("winner_plans")
}

model WinnerPlanNumber {
  id            String      @id @default(cuid())
  planId        String
  luckyNumberId String
  plan          WinnerPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  luckyNumber   LuckyNumber @relation(fields: [luckyNumberId], references: [id], onDelete: Cascade)
  @@unique([planId, luckyNumberId])
  @@map("winner_plan_numbers")
}

// A draw is the recorded fact that a slot won in a week. A week has at most
// one winning slot, and a slot wins at most once per cycle (everyone receives
// exactly once). Dropping either constraint allows a real defect.
model Draw {
  id      String   @id @default(cuid())
  weekId  String
  slotId  String
  drawnAt DateTime @default(now())
  notes   String?
  // 2.2 organizer discretion: a payout the organizer ASSIGNED (an emergency,
  // an agreement) rather than one the wheel produced. Both are legitimate and
  // behave identically — this only makes the difference visible in the record.
  assignedManually Boolean @default(false)
  week    Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  slot    Slot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  payouts Payout[]
  @@unique([weekId])
  @@unique([slotId])
  @@map("draws")
}

// Money that actually went out (ground truth 2.14: stored facts, in cents).
// gross/fee/net record what was ACTUALLY charged and handed over — historical
// truth, which may predate rule changes; expected values remain derivable.
model Payout {
  id            String        @id @default(cuid())
  luckyNumberId String
  drawId        String?
  grossAmount   Int
  feeAmount     Int
  netAmount     Int
  status        PayoutStatus  @default(PENDING)
  method        PaymentMethod?
  paidAt        DateTime?
  notes         String?
  // netAmount is what actually crosses the table: the draw settlement
  // DECREMENTS it by the winner's own-week contribution. The settlement
  // receipt points back here via PaymentEvent.settlementPayoutId.
  luckyNumber   LuckyNumber   @relation(fields: [luckyNumberId], references: [id], onDelete: Cascade)
  draw          Draw?         @relation(fields: [drawId], references: [id], onDelete: SetNull)
  settlementEvents PaymentEvent[]
  ledgerEntries    LedgerEntry[]
  @@map("payouts")
}

// D-32 audit trail: every organizer correction records what changed, from
// what to what, and when. Append-only from the app's perspective.
// APPEND-ONLY (D-32). A Postgres trigger raises on UPDATE and DELETE —
// see prisma/migrations/20260807030000_audit_log_append_only. A wrong entry
// is answered by a new entry, never by a rewritten one.
model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  summary   String
  before    String?
  after     String?
  createdAt DateTime @default(now())
  // Reading pages, filters by action and entity, and takes a date range.
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// The readable archive of a closed cycle (2.9): who paid what, who was paid
// out, how much, when. cycleId is a PLAIN STRING — deliberately no relation
// — so deleting the cycle can never cascade into (or be blocked by) its
// archive. The archive outlives the cycle; that is its whole point.
model CycleArchive {
  id        String   @id @default(cuid())
  cycleId   String   @unique
  cycleName String
  closedAt  DateTime
  /** JSON snapshot rendered human-readably by the archive page. */
  data      String
  createdAt DateTime @default(now())
  @@map("cycle_archives")
}

// Carried balance lives on the PERSON as a ledger and survives cycle deletion
// (ground truth 2.18). DEBT entries record where a balance came from; PAYMENT
// entries record settlements. The running total is derived, never stored.
model LedgerEntry {
  id          String          @id @default(cuid())
  personId    String
  type        LedgerEntryType
  amount      Int
  description String
  notes       String?
  /** How the money arrived. Null for DEBT and FORGIVEN — nothing moved. */
  method      PaymentMethod?
  /** The day it HAPPENED, which is not always the day it was typed in. */
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())
  // THE PAYOUT THIS CAME OUT OF, for a carry deduction (D-23).
  //
  // A deduction is ONE fact in TWO rows: the payout is smaller AND the person
  // ledger says they paid. The ledger half had no link to the payout half, so
  // nothing could reverse it — and five paths destroy or reset a payout
  // (delete, move, undo the draw, replace on a manual assign, remove from the
  // cycle). Each left a PAYMENT entry reading "Deducted from payout — number
  // #19" pointing at a payout that no longer exists, with the balance still
  // showing as settled.
  //
  // Exactly the role PaymentEvent.settlementPayoutId plays for the winner-week
  // settlement, which IS reversible for precisely this reason.
  payoutId    String?
  person      Person          @relation(fields: [personId], references: [id])
  payout      Payout?         @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  @@index([payoutId])
  @@map("ledger_entries")
}

// Platform-level configuration (2.6: everything configurable, nothing
// hardcoded). Key/value with JSON-encoded values, typed and defaulted at the
// accessor layer (lib/settings.ts) — new settings need no schema change.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  @@map("settings")
}

// THE AGREEMENT WORDING, VERSIONED BY APPEND (2.6, 2.23).
//
// Editable by the organizer like a message template — but an edit MINTS A NEW
// ROW rather than overwriting one. That is the whole safety property: a
// signature is bound by hash to the text it was shown, so a row that could be
// rewritten in place would leave every past signature pointing at wording that
// no longer exists. Versions accumulate; none is ever edited or deleted.
//
// The body holds the CLAUSE TEMPLATE with {placeholders}. It is not the
// document — the document is what `renderAgreement` produces once a real
// participation's figures are substituted in, and that rendered text is what
// gets hashed and stored with the signature.
model AgreementVersion {
  id        String   @id @default(cuid())
  /** 1, 2, 3 … — what the member sees quoted on the document they sign. */
  version   Int      @unique
  /** The clause template, {placeholders} unsubstituted. */
  body      String
  /** Why this version exists, for the organizer reading the list later. */
  note      String?
  createdAt DateTime @default(now())
  signatures AgreementSignature[]
  @@map("agreement_versions")
}

// ONE SIGNATURE, AND THE EVIDENCE AROUND IT.
//
// Append-only in spirit and in practice: nothing in the platform updates or
// deletes one of these. A member who signs again after a second welcome gets a
// SECOND row, so the whole history of what they agreed to and when is readable
// years later.
//
// WHAT IS HERE IS WHAT A BROWSER CAN HONESTLY GIVE. There is no MAC address
// column: a web page cannot read one on any browser, and a column that can
// never be filled is a claim the record cannot support.
model AgreementSignature {
  id              String   @id @default(cuid())
  participationId String
  /** Denormalised on purpose: the person outlives the participation (2.5). */
  personId        String
  agreementVersionId String
  /**
   * SHA-256 of the EXACT text rendered for them, hex.
   *
   * The load-bearing field. The version says which wording; this proves it
   * character for character, including the figures that were theirs on the
   * day — which the version alone cannot, because the figures are derived.
   */
  documentHash    String
  /** The rendered text itself, verbatim. The hash proves it; this IS it. */
  documentText    String
  signedAt        DateTime @default(now())
  /** Corroborating detail, never identity — carriers share addresses. */
  ip              String
  userAgent       String
  browser         String
  os              String
  deviceType      String
  /** "390x844" — from window.screen, sent with the signature. */
  screen          String?
  /** IANA zone from Intl.DateTimeFormat, e.g. "America/New_York". */
  timezone        String?
  /** City/region/country when the host provides geo headers, else null. */
  location        String?
  participation   Participation    @relation(fields: [participationId], references: [id], onDelete: Cascade)
  person          Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  agreementVersion AgreementVersion @relation(fields: [agreementVersionId], references: [id])
  @@index([participationId, signedAt])
  @@index([personId])
  @@map("agreement_signatures")
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ParticipationStatus {
  ACTIVE
  CLOSED
}

enum PaymentMethod {
  ZELLE
  CASH
  OTHER
}

enum WinnerPlanMode {
  ALONE
  TOGETHER
  /** This number wins; the shuffle may attach one random partner (2.3). */
  OPEN_PARTNER
}

enum WinnerPlanStatus {
  PLANNED
  FULFILLED
  CANCELLED
}

enum LedgerEntryType {
  DEBT
  /** Money actually received against the balance. */
  PAYMENT
  /**
   * The organizer WROTE IT OFF (2.2 organizer discretion). It clears the
   * balance exactly like a payment, but it is a different fact and the
   * history must never blur the two — nobody paid this.
   */
  FORGIVEN
}

enum MessageTrigger {
  /** Direct result of an organizer action (mark-paid confirmation only). */
  AUTOMATIC
  /** The organizer previewed and pressed send (2.20). */
  MANUAL
}

enum MessageSendStatus {
  /**
   * DELIVERY THE PROVIDER HAS CONFIRMED. Nothing else may be written as SENT.
   *
   * This used to mean "accepted by Twilio", and that conflation is what let
   * ten rows read SENT while Twilio's own records showed all ten failed with
   * 63112 and billed. Twilio answers a create with 201 + status:"queued",
   * which is acceptance, not delivery; the refusal arrives asynchronously.
   */
  SENT
  /**
   * Twilio has the message and has confirmed NOTHING about its fate.
   *
   * The honest resting state for a send whose callback has not arrived — and
   * the state every message stays in when no public APP_BASE_URL is set, since
   * Twilio cannot reach localhost.
   */
  ACCEPTED
  /** The provider refused it — error records why. */
  FAILED
}

enum PayoutStatus {
  PENDING
  COLLECTED
}

// WHAT THE ORGANIZER ACTUALLY HOLDS, at a moment in time.
//
// The ONE stored fact in the cash-position feature (2.14). Everything it is
// compared against — what he should be holding, what is owed forward, what is
// committed to pending payouts, what of it is his own fee — is derived at read
// time from money that already happened.
//
// A RECORD, NOT A SETTING. Each entry is a reading with its own date, kept
// forever, so he can look back at what he held in week 8 versus week 12 and
// see drift across the cycle rather than only today's snapshot.
//
// cycleId is a PLAIN STRING with no relation, deliberately: a reading is about
// HIM, not about one cycle, and deleting a cycle must never take his cash
// history with it — the same reasoning as CycleArchive.
model CashReading {
  id          String   @id @default(cuid())
  cycleId     String?
  /** Cents. The whole figure — the sum of the parts below when both are given. */
  totalAmount Int
  /** Optional split, when separating them is clearer than one total. */
  bankAmount  Int?
  cashAmount  Int?
  /** The day the reading was TAKEN, which is not always the day it was typed. */
  readAt      DateTime
  note        String?
  createdAt   DateTime @default(now())
  @@index([readAt])
  @@index([cycleId])
  @@map("cash_readings")
}
